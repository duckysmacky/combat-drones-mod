{
  // Gunship Plane (rocket pod): small armed fixed-wing, ramp-launched and routed like a loitering munition,
  // flown manually via the Mission Planner's "Take control". A hard crash or being shot down sets off its fuel and ammo (blastPower, weaker than a warhead); low rate of fire explosive Rockets; payloadCapacity = magazine size in rockets.
  "category": "RAMP_AUTOPILOT",
  "maxSpeed": 0.9,
  "acceleration": 0.05,
  "batteryOrFuelCapacity": 6000,
  "drainRatePerTick": 1.0,
  "blastPower": 3.5,
  "payloadCapacity": 16,
  "maxHP": 100,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 1.6,
  "hitboxHeight": 0.7,
  "defaultCruiseAltitude": 40,
  "agility": 1.1,
  "controlScheme": "STICK",
  "weaponType": "ROCKET_POD",
  "motorSoundRange": 96,
  // Engine loop sound event (combat_drones:<name>); unset = the family default
  "engineSound": "unit.engine_piston"
}
