{
  // Attack Plane: small, fast machine-gun fixed-wing for hunting other aircraft, ramp-launched and routed like a loitering munition,
  // flown manually via the Mission Planner's "Take control". A hard crash or being shot down sets off its fuel and ammo (blastPower, weaker than a warhead); high rate of fire Rifle Rounds, no splash; payloadCapacity = belt size in rounds.
  "category": "RAMP_AUTOPILOT",
  "maxSpeed": 1.4,
  "acceleration": 0.09,
  "batteryOrFuelCapacity": 4800,
  "drainRatePerTick": 1.0,
  "blastPower": 2.5,
  "payloadCapacity": 600,
  "maxHP": 70,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 1.2,
  "hitboxHeight": 0.5,
  "defaultCruiseAltitude": 40,
  "agility": 1.8,
  "controlScheme": "STICK",
  "weaponType": "GUN_MOUNT",
  "motorSoundRange": 160,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    "bands": [
      {"event": "engine.attack.near", "until": 0.3},
      {"event": "engine.attack.mid", "until": 0.65},
      {"event": "engine.attack.far", "until": 1.0}
    ]
  }
}
