{
  // Standard Racer: balanced kamikaze racer. One Fragmentation Grenade slot boosts the blast.
  "category": "HAND_FLOWN",
  "maxSpeed": 1.75,
  "acceleration": 0.16,
  "batteryOrFuelCapacity": 2400,
  "drainRatePerTick": 1.0,
  "blastPower": 4.5,
  "payloadCapacity": 1,
  "maxHP": 25,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 0.5,
  "hitboxHeight": 0.25,
  "signalRange": 250,
  "impactDetonates": true,
  "motorSoundRange": 60,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    // A touch quieter than the planes: racers are everywhere in a fight
    "volume": 0.7,
    "bands": [
      {"event": "engine.quad.near", "until": 0.3},
      {"event": "engine.quad.mid", "until": 0.65},
      {"event": "engine.quad.far", "until": 1.0}
    ]
  },
  "defaultBattery": "STANDARD",
  "controlScheme": "FPV",
  "payload": "GRENADE"
}
