{
  // Recon Drone: blacked-out long-range scout. Slowest FPV drone, biggest battery and signal range, no payload.
  // Still a kamikaze, with a small blast. The pilot rides along from a stand-in body, so signalRange is not limited
  // by entity tracking.
  "category": "HAND_FLOWN",
  "maxSpeed": 1.3,
  "acceleration": 0.11,
  "batteryOrFuelCapacity": 3600,
  "drainRatePerTick": 1.0,
  "blastPower": 3.0,
  "payloadCapacity": 0,
  "maxHP": 25,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 0.65,
  "hitboxHeight": 0.3,
  "signalRange": 512,
  "impactDetonates": true,
  // Its camera locks on to enemies like the Recon UAV's (no tracking dots); lock-on settings are in [recon_drone]
  "sensor": true,
  "motorSoundRange": 32,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    // A scout: much quieter and heard from half as far as the other FPV drones
    "volume": 0.45,
    "bands": [
      {"event": "engine.quad.near", "until": 0.3},
      {"event": "engine.quad.mid", "until": 0.65},
      {"event": "engine.quad.far", "until": 1.0}
    ]
  },
  "defaultBattery": "HEAVY",
  "controlScheme": "FPV"
}
