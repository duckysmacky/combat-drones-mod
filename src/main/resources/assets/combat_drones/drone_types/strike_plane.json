{
  // Strike Plane: small rocket-armed fixed-wing, ramp-launched and routed like a loitering munition,
  // flown manually via the Mission Planner's "Take control". A hard crash or being shot down sets off its fuel and ammo (blastPower, weaker than a warhead); low rate of fire explosive Rockets; payloadCapacity = rocket bay units (64 Rockets or 24 Heavy Rockets, see [rockets.*] bayUnits).
  "category": "RAMP_AUTOPILOT",
  "maxSpeed": 0.9,
  "acceleration": 0.05,
  "batteryOrFuelCapacity": 6000,
  "drainRatePerTick": 1.0,
  "blastPower": 3.5,
  "payloadCapacity": 192,
  "maxHP": 100,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 1.6,
  "hitboxHeight": 0.7,
  "defaultCruiseAltitude": 40,
  "agility": 1.15,
  // Pitch rate multiplier on top of agility: pulls up out of a rocket run quickly
  "pitchAgility": 1.25,
  "controlScheme": "STICK",
  "weaponType": "ROCKET_POD",
  "motorSoundRange": 160,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    "bands": [
      {"event": "engine.strike.near", "until": 0.3},
      {"event": "engine.strike.mid", "until": 0.65},
      {"event": "engine.strike.far", "until": 1.0}
    ]
  }
}
