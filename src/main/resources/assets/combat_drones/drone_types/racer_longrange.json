{
  // Long-Range Racer: slowest racer, biggest battery and signal range. One grenade slot.
  // The pilot rides along from a stand-in body, so signalRange is not limited by entity tracking.
  "category": "HAND_FLOWN",
  "maxSpeed": 1.45,
  "acceleration": 0.125,
  "batteryOrFuelCapacity": 3600,
  "drainRatePerTick": 1.0,
  "blastPower": 4.5,
  "payloadCapacity": 1,
  "maxHP": 25,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 0.65,
  "hitboxHeight": 0.3,
  "signalRange": 400,
  "impactDetonates": true,
  "motorSoundRange": 60,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    // A touch quieter than the planes: racers are everywhere in a fight
    "volume": 0.7,
    "bands": [
      {"event": "engine.quad.near", "until": 0.3},
      {"event": "engine.quad.mid", "until": 0.65},
      {"event": "engine.quad.far", "until": 1.0}
    ]
  },
  "defaultBattery": "HEAVY",
  "controlScheme": "FPV",
  "payload": "GRENADE"
}
