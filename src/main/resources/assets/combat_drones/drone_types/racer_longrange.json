{
  // Long-Range Racer: slowest racer, biggest battery and signal range. One grenade slot.
  // The pilot rides along from a stand-in body, so signalRange is not limited by entity tracking.
  "category": "HAND_FLOWN",
  "maxSpeed": 1.45,
  "acceleration": 0.125,
  "batteryOrFuelCapacity": 3600,
  "drainRatePerTick": 1.0,
  "blastPower": 4.5,
  "payloadCapacity": 1,
  "maxHP": 25,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 0.65,
  "hitboxHeight": 0.3,
  "signalRange": 400,
  "impactDetonates": true,
  "motorSoundRange": 60,
  "defaultBattery": "HEAVY",
  "controlScheme": "FPV",
  "payload": "GRENADE"
}
