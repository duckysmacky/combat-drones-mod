{
  // DJI Drone: stable camera quad that drops a Bomb from its bay. Survives impacts.
  // Flown with velocity controls (WASD + Space/Shift), always stabilized: control scheme arrives in M4.
  // blastPower is 0 because the drone itself never explodes, only the dropped bomb does.
  "category": "HAND_FLOWN",
  "maxSpeed": 0.9,
  "acceleration": 0.07,
  "batteryOrFuelCapacity": 4800,
  "drainRatePerTick": 1.0,
  "blastPower": 0,
  "payloadCapacity": 1,
  "maxHP": 16,
  "signalRange": 144,
  "motorSoundRange": 32,
  "defaultBattery": "STANDARD"
}
