{
  // DJI Drone: stable camera quad that drops a Bomb from its bay. Survives impacts.
  // Flown with velocity controls (WASD + Space/Shift), always stabilized: control scheme arrives in M4.
  // payloadCapacity is the bomb bay size in units: 4 light, 2 medium or 1 heavy bomb (see [bombs.*] config).
  // blastPower is 0: a downed DJI only explodes with the bombs it carries.
  "category": "HAND_FLOWN",
  "maxSpeed": 0.7,
  "acceleration": 0.07,
  "batteryOrFuelCapacity": 4800,
  "drainRatePerTick": 1.0,
  "blastPower": 0,
  "payloadCapacity": 4,
  "maxHP": 16,
  "signalRange": 144,
  "motorSoundRange": 32,
  "defaultBattery": "STANDARD",
  "controlScheme": "DJI",
  "payload": "BOMB"
}
