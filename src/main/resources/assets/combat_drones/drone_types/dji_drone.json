{
  // DJI Drone: stable camera quad that drops a Bomb from its bay. Survives impacts.
  // Flown with velocity controls (WASD + Space/Shift), always stabilized. Slow to spin up, long range.
  // payloadCapacity is the bomb bay size in units: 4 light, 2 medium or 1 heavy bomb (see [bombs.*] config).
  // blastPower is 0: a downed DJI only explodes with the bombs it carries.
  "category": "HAND_FLOWN",
  "maxSpeed": 0.63,
  "acceleration": 0.045,
  "batteryOrFuelCapacity": 4800,
  "drainRatePerTick": 1.0,
  "blastPower": 0,
  "payloadCapacity": 4,
  "maxHP": 40,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 0.7,
  "hitboxHeight": 0.3,
  "signalRange": 400,
  "motorSoundRange": 48,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    "bands": [
      {"event": "engine.dji.near", "until": 0.3},
      {"event": "engine.dji.mid", "until": 0.65},
      {"event": "engine.dji.far", "until": 1.0}
    ]
  },
  "defaultBattery": "STANDARD",
  "controlScheme": "DJI",
  "payload": "BOMB"
}
