{
  // Micro Racer: fastest and most fragile racer. No payload slot, speed is the weapon.
  // Units: speed in blocks/tick (1 = 72 km/h), battery in charge units, HP like mobs.
  // Full-throttle flight time = batteryOrFuelCapacity / drainRatePerTick ticks.
  "category": "HAND_FLOWN",
  "maxSpeed": 2.35,
  "acceleration": 0.235,
  "batteryOrFuelCapacity": 1800,
  "drainRatePerTick": 1.0,
  "blastPower": 4.0,
  "payloadCapacity": 0,
  "maxHP": 20,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 0.4,
  "hitboxHeight": 0.2,
  "signalRange": 150,
  "impactDetonates": true,
  "motorSoundRange": 60,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    // A touch quieter than the planes: racers are everywhere in a fight
    "volume": 0.7,
    "bands": [
      {"event": "engine.micro.near", "until": 0.3},
      {"event": "engine.micro.mid", "until": 0.65},
      {"event": "engine.micro.far", "until": 1.0}
    ]
  },
  "defaultBattery": "LIGHT",
  "controlScheme": "FPV"
}
