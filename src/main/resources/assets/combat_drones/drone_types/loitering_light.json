{
  // Light Loitering Munition: fast, small warhead, a guided rocket. "Take control" is point-and-strike: click a spot on the feed and it dives there.
  // Fuel in units; full-throttle endurance = capacity / drain ticks.
  "category": "RAMP_AUTOPILOT",
  "maxSpeed": 1.8,
  "acceleration": 0.2,
  "batteryOrFuelCapacity": 3600,
  "drainRatePerTick": 1.0,
  "blastPower": 6.5,
  "payloadCapacity": 0,
  "maxHP": 30,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 0.9,
  "hitboxHeight": 0.5,
  "defaultCruiseAltitude": 40,
  // Rocket-like: rolls, pitches and turns this many times faster than a plane
  "agility": 2.75,
  "controlScheme": "CLICK_DESIGNATE",
  "motorSoundRange": 128,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    "bands": [
      {"event": "engine.light.near", "until": 0.3},
      {"event": "engine.light.mid", "until": 0.65},
      {"event": "engine.light.far", "until": 1.0}
    ],
    // Air roar swelling in a steep, fast dive; the scream of the last seconds before impact
    "dive": "unit.dive_light",
    "terminal": "unit.terminal_light"
  },
  "impactDetonates": true
}
