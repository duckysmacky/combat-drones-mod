{
  // Recon UAV: unarmed, long endurance. Can never be hand-flown or steered into anything;
  // the only manual input is the camera gimbal. A hard crash or being shot down sets off its fuel (blastPower).
  // A gentle touchdown (Return) lands it intact.
  "category": "RAMP_AUTOPILOT",
  "maxSpeed": 1.0,
  "acceleration": 0.08,
  "batteryOrFuelCapacity": 24000,
  "drainRatePerTick": 1.0,
  "blastPower": 2.5,
  "payloadCapacity": 0,
  "maxHP": 75,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 1.4,
  "hitboxHeight": 0.6,
  "defaultCruiseAltitude": 60,
  "agility": 1.2,
  "controlScheme": "GIMBAL_OBSERVE",
  "armed": false,
  // Sweeps for enemies in line of sight and marks them on the owner's Mission Planner; its camera can lock targets
  "sensor": true,
  "motorSoundRange": 128,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    "bands": [
      {"event": "engine.recon.near", "until": 0.3},
      {"event": "engine.recon.mid", "until": 0.65},
      {"event": "engine.recon.far", "until": 1.0}
    ]
  }
}
