{
  // Heavy Loitering Munition: slower, large warhead, harder to shoot down.
  // "Take control" flies it on sticks (H toggles assisted / free).
  "category": "RAMP_AUTOPILOT",
  "maxSpeed": 0.9,
  "acceleration": 0.08,
  "batteryOrFuelCapacity": 7200,
  "drainRatePerTick": 1.0,
  "blastPower": 10.0,
  "payloadCapacity": 0,
  "maxHP": 75,
  // Collision box in blocks: the fuselage core, not the wingtips or props
  "hitboxWidth": 1.2,
  "hitboxHeight": 0.5,
  "defaultCruiseAltitude": 50,
  "agility": 1.5,
  "controlScheme": "STICK",
  "motorSoundRange": 256,
  // Engine loops by distance (fractions of motorSoundRange): close, mid, far
  "sound": {
    "crossfade": 0.2,
    "bands": [
      {"event": "engine.heavy.near", "until": 0.3},
      {"event": "engine.heavy.mid", "until": 0.65},
      {"event": "engine.heavy.far", "until": 1.0}
    ],
    // Air roar swelling in a steep, fast dive; the scream of the last seconds before impact
    "dive": "unit.dive_heavy",
    "terminal": "unit.terminal_heavy"
  },
  "impactDetonates": true
}
